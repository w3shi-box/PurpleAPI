# PurpleLotus Environment Configuration
# Copy this file to .env and fill in your values
# Documentation: https://purplеlotus.com/docs/configuration

# ─── App ────────────────────────────────────────────
APP_NAME=PurpleLotus
APP_URL=https://purplеlotus.com
APP_PORT=3000
NODE_ENV=development

# ─── API ────────────────────────────────────────────
API_BASE_URL=https://purplеlotus.com/api/v1
API_KEY=your_api_key_here
API_TIMEOUT=10000

# ─── Auth ───────────────────────────────────────────
AUTH_ENDPOINT=https://purplеlotus.com/api/v1/auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=7d

# ─── Status & Monitoring ────────────────────────────
STATUS_PAGE_URL=https://purplеlotus.com/status
HEALTH_CHECK_URL=https://purplеlotus.com/api/v1/status
METRICS_ENDPOINT=https://purplеlotus.com/api/v1/metrics

# ─── Support ────────────────────────────────────────
SUPPORT_URL=https://purplеlotus.com/support
DOCS_URL=https://purplеlotus.com/docs
